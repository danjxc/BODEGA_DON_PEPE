<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/notificationFragment"
        android:name="pe.edu.cibertec.appfragmentsnavigation.ProductsFragment"
        android:label="@string/textproducts"
        tools:layout="@layout/fragment_products" />
    <fragment
        android:id="@+id/galleryFragment"
        android:name="pe.edu.cibertec.appfragmentsnavigation.CategoryFragment"
        android:label="@string/textcategory"
        tools:layout="@layout/fragment_category" />
    <fragment
        android:id="@+id/homeFragment"
        android:name="pe.edu.cibertec.appfragmentsnavigation.HomeFragment"
        android:label="@string/texthome"
        tools:layout="@layout/fragment_home" />
    <fragment
        android:id="@+id/profileFragment"
        android:name="pe.edu.cibertec.appfragmentsnavigation.ProfileFragment"
        android:label="@string/textprofile"
        tools:layout="@layout/fragment_profile" />
</navigation>